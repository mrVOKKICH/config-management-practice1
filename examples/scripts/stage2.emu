# Стартовый скрипт этапа 2: комментарии, ввод и вывод, ошибки.
# Строки, начинающиеся с #, пропускаются.

ls
ls -l /home   # комментарий после команды тоже игнорируется
cd /tmp
foo bar       # неизвестная команда: ошибка, но скрипт продолжается
exit now      # неверные аргументы: ошибка, скрипт продолжается
ls after-error
exit
ls эта строка не будет выполнена
